{
  "manifest_version": 2,
  "name": "Мои контейнеры",
  "version": "1.0.0",
  "description": "Создание и массовое удаление изолированных контейнеров-вкладок.",
  "browser_specific_settings": {
    "gecko": {
      "id": "container-manager@mikl",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "menus"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Мои контейнеры",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}